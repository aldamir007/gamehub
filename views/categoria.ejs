<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= nome %> - GameHub</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include("partials/nav") %>
    <h1>🎮 GameHub</h1>

    <h2>Jogos de <%= nome %></h2>

    <div class="lista-jogos">

        <% jogos.forEach(jogo => { %>

            <div class="card-jogo">

                <h3><%= jogo.nome %></h3>

                <p>🎯 Gênero: <%= jogo.genero %></p>

                <p>💻 Plataforma: <%= jogo.plataforma %></p>

                <p>⭐ Nota: <%= jogo.nota %></p>

                <a class="botao" href="/jogos/<%= jogo.id %>">
                    Ver detalhes
                </a>

            </div>

        <% }) %>

    </div>

    <br>

    <a class="botao" href="/categorias">
        ← Voltar para categorias
    </a>

</body>

</html>